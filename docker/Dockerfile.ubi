FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

ARG VERSION=dev
ARG RELEASE=0

LABEL name="netbird-dashboard" \
      maintainer="NetBird <dev@netbird.io>" \
      vendor="NetBird GmbH" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="NetBird Dashboard" \
      description="Web UI for managing NetBird peers, users, and access policies."

# Only nginx-core: the nginx metapackage pulls in a default web root and logos
# that would clash with out/. Our nginx config lives outside the RPM-owned
# /etc/nginx/nginx.conf so no packaged file is modified in a later layer.
RUN microdnf module enable -y nginx:1.26 && \
    microdnf install -y --nodocs bash jq nginx-core tzdata && \
    microdnf clean all && \
    mkdir -p /etc/nginx/http.d /tmp/nginx /run/netbird-dashboard

STOPSIGNAL SIGINT
EXPOSE 8080

WORKDIR /usr/share/nginx/html

COPY LICENSE /licenses/AGPL-3.0.txt
COPY licenses/ /licenses/
COPY docker/default.conf /etc/nginx/http.d/default.conf
COPY docker/nginx.conf /etc/nginx/netbird.conf
COPY docker/rootless.conf /etc/nginx/http.d/rootless.conf
COPY docker/snippets/ /etc/nginx/snippets/
COPY docker/gen_runtime_config.sh /usr/local/bin/gen_runtime_config.sh
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY out/ /usr/share/nginx/html/

RUN sed -i \
      -e 's/listen 80 default_server;/listen 8080 default_server;/' \
      -e 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' \
      /etc/nginx/http.d/default.conf && \
    sed -i '/^user nginx;$/d' /etc/nginx/netbird.conf && \
    chmod +x /usr/local/bin/gen_runtime_config.sh /usr/local/bin/entrypoint.sh && \
    chmod -R a+rX /licenses && \
    chmod -R a-w /usr/share/nginx/html && \
    chgrp -R 0 /tmp/nginx /run/netbird-dashboard && \
    chmod -R g=u /tmp/nginx /run/netbird-dashboard

USER 10001:0
ENV NGINX_CONF=/etc/nginx/netbird.conf
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/sbin/nginx", "-c", "/etc/nginx/netbird.conf", "-e", "/dev/stderr", "-g", "pid /tmp/nginx.pid;"]
