#!/bin/bash
# nb-dashboard-deploy (v2): server-side forced command of the CI deploy key.
#   ssh <deploy-user>@<host> deploy < dashboard-release.tgz
#   ssh <deploy-user>@<host> rollback [<release>]
#   ssh <deploy-user>@<host> status
#   ssh <deploy-user>@<host> prune
# Runs as root via: sudo -n /usr/local/sbin/nb-dashboard-deploy <cmd>
#
# Package (built by CI, see deploy/server/README.md):
#   out/       static export incl. out/.asset-manifest.json
#   docker/    this repo's docker/ directory (Dockerfile, nginx, generator)
#
# Release order (asset-first, the old container serves until the new one is
# verified):
#   a) copy the new hashed assets into static-pool/ (never deletes)
#   b) build netbird-dashboard-zh:<release> from the package (no Node needed)
#   c) gate: run the image once with the production env; its entrypoint
#      generates /runtime-config.json and runs `nginx -t`, so a bad env or
#      config fails here and nothing is switched
#   d) tag :current, `docker compose up -d dashboard`, health check, record
#      CURRENT; an unhealthy start rolls back to the previous image
#   e) prune: drop pool files referenced by none of the last $KEEP releases
#      AND older than $MIN_AGE_DAYS days; same rule for releases and images
set -euo pipefail
umask 022
export LC_ALL=C

BASE=${NB_DASHBOARD_BASE:-/opt/netbird/dashboard-zh}
REL=$BASE/releases
POOL=$BASE/static-pool
HISTORY=$BASE/HISTORY            # one release id per line, oldest first
COMPOSE_FILE=${NB_COMPOSE_FILE:-/opt/netbird/docker-compose.yml}
COMPOSE_PROJECT=${NB_COMPOSE_PROJECT:-netbird}
ENV_FILE=${NB_DASHBOARD_ENV:-/opt/netbird/dashboard.env}
SERVICE=dashboard
CONTAINER=netbird-dashboard
IMAGE=netbird-dashboard-zh
KEEP=5
MIN_AGE_DAYS=14
DOCKER=${NB_DOCKER:-/usr/bin/docker}
LOCK=${NB_LOCK:-/run/lock/nb-dashboard-deploy.lock}

log() { echo "nb-dashboard-deploy: $*" >&2; }
die() { log "ERROR: $*"; exit 1; }

compose() { "$DOCKER" compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" "$@"; }

container_state() {
    "$DOCKER" inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing
}

# Last N release ids from HISTORY that still have an image.
recent_releases() {
    [[ -f "$HISTORY" ]] || return 0
    tail -n "$1" "$HISTORY"
}

health_check() {
    for _ in $(seq 1 30); do
        if [[ $(container_state) == running ]] &&
            "$DOCKER" exec "$CONTAINER" curl -fsS -o /dev/null http://127.0.0.1/runtime-config.json 2>/dev/null &&
            "$DOCKER" exec "$CONTAINER" curl -fsS -o /dev/null http://127.0.0.1/ 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    return 1
}

switch_to() { # <release>
    local id=$1
    "$DOCKER" image inspect "$IMAGE:$id" >/dev/null 2>&1 || die "image $IMAGE:$id not found"
    "$DOCKER" tag "$IMAGE:$id" "$IMAGE:current"
    compose up -d --no-deps --force-recreate "$SERVICE" >&2
    health_check
}

record_current() { # <release>
    echo "$1" >"$BASE/CURRENT.tmp" && mv "$BASE/CURRENT.tmp" "$BASE/CURRENT"
}

publish_assets() { # <release dir>
    # Immutable, content-addressed files only. No --delete, no -t: mtime is
    # the time a file entered the pool, which the age rule of prune uses.
    install -d -m 755 "$POOL/_next" "$POOL/assets"
    rsync -rlp --ignore-existing "$1/out/_next/static" "$POOL/_next/"
    find "$1/out/assets" -maxdepth 1 -type f -regextype posix-extended \
        -regex '.*/chunk\.[0-9a-f]{8}\.js(\.gz)?' -print0 |
        rsync -rlp --ignore-existing --from0 --files-from=- --no-relative / "$POOL/assets/"
}

prune() {
    local keep_ids keep_list cutoff id
    keep_ids=$(recent_releases "$KEEP")
    keep_list=$(mktemp)
    # Pool paths referenced by the kept releases.
    for id in $keep_ids; do
        local manifest="$REL/$id/out/.asset-manifest.json"
        [[ -f "$manifest" ]] || continue
        jq -r '.files | keys[] | select(startswith("_next/static/") or startswith("assets/chunk."))' "$manifest"
    done | sort -u >"$keep_list"

    if [[ ! -s "$keep_list" ]]; then
        rm -f "$keep_list"
        log "prune: no manifests of recent releases found, keeping everything"
        return 0
    fi
    # Pool files: unreferenced AND older than MIN_AGE_DAYS.
    (cd "$POOL" && find . -type f -mtime +"$MIN_AGE_DAYS" -printf '%P\n') | sort |
        comm -23 - "$keep_list" | while IFS= read -r file; do
            rm -f -- "${POOL:?}/$file"
        done
    rm -f "$keep_list"
    find "$POOL" -mindepth 1 -type d -empty -delete

    # Releases and images: not among the last KEEP AND older than MIN_AGE_DAYS.
    cutoff=$(date -d "-$MIN_AGE_DAYS days" +%Y%m%d-%H%M%S)
    for dir in "$REL"/*/; do
        id=$(basename "$dir")
        grep -qxF "$id" <<<"$keep_ids" && continue
        [[ "$id" < "$cutoff" ]] || continue
        [[ "$id" == "$(cat "$BASE/CURRENT" 2>/dev/null)" ]] && continue
        rm -rf -- "${REL:?}/$id"
        "$DOCKER" image rm "$IMAGE:$id" >/dev/null 2>&1 || true
        if [[ -f "$HISTORY" ]]; then
            grep -vxF "$id" "$HISTORY" >"$HISTORY.tmp" || true
            mv "$HISTORY.tmp" "$HISTORY"
        fi
    done
}

deploy() {
    local id dir previous
    id=$(date +%Y%m%d-%H%M%S)
    dir=$REL/$id
    [[ ! -e "$dir" ]] || die "release $id already exists, retry in a second"
    install -d -m 755 "$dir"
    tar -xz -C "$dir" --no-same-owner
    for f in out/index.html out/.asset-manifest.json docker/Dockerfile docker/entrypoint.sh; do
        [[ -f "$dir/$f" ]] || { rm -rf -- "${dir:?}"; die "package lacks $f"; }
    done

    publish_assets "$dir"                                           # a
    local build_args=()
    if [[ -f "$BASE/apk-mirror" ]]; then # optional, e.g. https://mirror.example.com
        local mirror
        mirror=$(head -1 "$BASE/apk-mirror")
        [[ "$mirror" =~ ^https?://[A-Za-z0-9.-]+/?$ ]] || die "invalid $BASE/apk-mirror"
        build_args=(--build-arg "APK_MIRROR=$mirror")
    fi
    "$DOCKER" build -q "${build_args[@]}" -t "$IMAGE:$id" -f "$dir/docker/Dockerfile" "$dir" >/dev/null  # b
    if ! "$DOCKER" run --rm --network none --env-file "$ENV_FILE" "$IMAGE:$id" true; then  # c
        "$DOCKER" image rm "$IMAGE:$id" >/dev/null 2>&1 || true
        rm -rf -- "${dir:?}"
        die "release $id rejected: entrypoint/config check failed, $CONTAINER left unchanged"
    fi

    previous=$(cat "$BASE/CURRENT" 2>/dev/null || true)
    if switch_to "$id"; then                                        # d
        echo "$id" >>"$HISTORY"
        record_current "$id"
        log "deployed $id"
    else
        log "release $id unhealthy after start"
        if [[ -n "$previous" ]] && "$DOCKER" image inspect "$IMAGE:$previous" >/dev/null 2>&1; then
            switch_to "$previous" && log "rolled back to $previous"
        fi
        die "deploy of $id failed"
    fi
    prune                                                           # e
}

rollback() { # [release]
    local target=${1:-} current
    current=$(cat "$BASE/CURRENT" 2>/dev/null || true)
    if [[ -z "$target" ]]; then
        target=$(grep -vxF "$current" "$HISTORY" 2>/dev/null | tail -1 || true)
    fi
    [[ "$target" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "no release to roll back to"
    switch_to "$target" || die "rollback to $target unhealthy"
    record_current "$target"
    log "rolled back to $target (assets of all kept releases stay in the pool)"
}

status() {
    echo "current: $(cat "$BASE/CURRENT" 2>/dev/null || echo none)"
    echo "container: $(container_state) ($("$DOCKER" inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null || echo -))"
    echo "releases (newest last):"
    recent_releases 20 | sed 's/^/  /'
    echo "static-pool: $(find "$POOL" -type f 2>/dev/null | wc -l) files"
}

exec 9>"$LOCK"
flock -n 9 || die "another deploy is running"

# The forced command passes SSH_ORIGINAL_COMMAND as one argument.
read -r CMD ARG EXTRA <<<"${*:-deploy}"
[[ -z "${EXTRA:-}" ]] || die "too many arguments"
[[ -z "${ARG:-}" || "$ARG" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "invalid release id: $ARG"
case "$CMD" in
    deploy) deploy ;;
    rollback) rollback "${ARG:-}" ;;
    status) status ;;
    prune) prune ;;
    *) die "unknown command: $CMD (deploy | rollback [release] | status | prune)" ;;
esac
